{
  "version": 4,
  "configurations": [
    {
      "name": "MinGW-w64 (GCC 14.2 x64)",
      "compilerPath": "C:/mingw64/bin/g++.exe",
      "compilerArgs": ["-std=c++20"],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/Core",
        "${workspaceFolder}/Utils",
        "${workspaceFolder}/Components",
        "${workspaceFolder}/..",
        "${workspaceFolder}/../..",
        "C:/mingw64/x86_64-w64-mingw32/include",
        "C:/mingw64/include"
      ],
      "defines": [
        "_WIN32_WINNT=0x0601",
        "UNICODE",
        "_UNICODE",
        "NOMINMAX",
        "WIN32_LEAN_AND_MEAN"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/..",
          "${workspaceFolder}/../.."
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
