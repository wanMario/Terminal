{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 terminal_demo (交互)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/terminal_demo.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/mingw64/bin;${env:PATH}"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "为 gdb 启用美化打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "cmake: build"
    },
    {
      "name": "调试 terminal_demo (--selftest)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/terminal_demo.exe",
      "args": ["--selftest"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/mingw64/bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "为 gdb 启用美化打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "cmake: build"
    }
  ]
}
